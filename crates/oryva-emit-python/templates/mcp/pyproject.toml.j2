[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ c.mcp_dist }}"
version = "{{ c.version }}"
description = {{ ("MCP server for the " ~ c.title) | q }}
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "{{ c.dist }}>={{ c.version }}",
    "mcp>=2,<3",
]

[project.scripts]
{{ c.mcp_dist }} = "{{ c.mcp_pkg }}.server:main"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ c.mcp_pkg }}"]

[tool.ruff.lint]
select = ["E4", "E7", "E9", "F", "I"]
