{% endfor %}
)

{% if c.servers %}
ENVIRONMENTS: Dict[str, str] = {
{% for s in c.servers %}
    {{ s.name | q }}: {{ s.url | q }},
{% endfor %}
}
DEFAULT_ENVIRONMENT = {{ c.default_env | q }}
Environment = Literal[{% for s in c.servers %}{{ s.name | q }}{% if not loop.last %}, {% endif %}{% endfor %}]
{% endif %}


def _resolve_base_url(environment: Optional[str], base_url: Optional[str]) -> str:
    """An explicit base_url wins, then `environment`, then {{ c.env_base_url }}, then the default."""
    if base_url:
        return base_url
{% if c.servers %}
    if environment is not None:
        if environment not in ENVIRONMENTS:
            raise {{ c.error_base }}(
                f"Unknown environment {environment!r}. Choose one of: {', '.join(ENVIRONMENTS)}."
            )
        return ENVIRONMENTS[environment]
    return os.environ.get("{{ c.env_base_url }}") or ENVIRONMENTS[DEFAULT_ENVIRONMENT]
{% else %}
    configured = os.environ.get("{{ c.env_base_url }}")
    if not configured:
        raise {{ c.error_base }}(
            "No base URL found. Pass base_url='https://...', or set the "
            "{{ c.env_base_url }} environment variable."
        )
    return configured
{% endif %}

{% if c.auth %}

def _resolve_auth(
{% for a in c.ctor_args %}
    {{ a.ident }}: Optional[str],
{% endfor %}
) -> Auth:
    """Use the first auth scheme whose credentials were passed or are in the environment."""
{% for s in c.auth %}
{% if s.kind == "api_key" %}
    key = {{ s.args[0].ident }} or os.environ.get({{ s.args[0].env | q }})
    if key:
        return api_key_auth({{ s.location | q }}, {{ s.name | q }}, key)
{% elif s.kind == "bearer" %}
    token = {{ s.args[0].ident }} or os.environ.get({{ s.args[0].env | q }})
    if token:
        return bearer_auth(token)
{% elif s.kind == "basic" %}
    username = {{ s.args[0].ident }} or os.environ.get({{ s.args[0].env | q }})
    password = {{ s.args[1].ident }} or os.environ.get({{ s.args[1].env | q }})
    if username and password:
        return basic_auth(username, password)
{% else %}
    client_id = {{ s.args[0].ident }} or os.environ.get({{ s.args[0].env | q }})
    client_secret = {{ s.args[1].ident }} or os.environ.get({{ s.args[1].env | q }})
    if client_id and client_secret:
        return OAuth2Auth(
            token_url={{ s.args[2].ident }} or os.environ.get({{ s.args[2].env | q }}) or {{ s.token_url | q }},
            client_id=client_id,
            client_secret=client_secret,
            scopes={{ s.scopes }},
        )
{% endif %}
{% endfor %}
    raise {{ c.error_base }}(
        {{ c.auth_help | q }}
    )
{% endif %}


class {{ c.class }}(SyncAPIClient):
    """Client for the {{ c.title | doc }}.

    Credentials, the environment and the base URL come from the arguments, or from the
    environment when you leave them out:
{% for a in c.ctor_args %}

    - `{{ a.ident }}`: {{ a.doc }} Falls back to `{{ a.env }}`.
{% endfor %}
    - `base_url`: Falls back to `{{ c.env_base_url }}`.
    """

{% for r in c.resources %}
    {{ r.module }}: {{ r.class }}
{% endfor %}
    with_raw_response: {{ c.class }}WithRawResponse

    def __init__(
        self,
        *,
{% for a in c.ctor_args %}
        {{ a.ident }}: Optional[str] = None,
{% endfor %}
{% if c.webhook_secret_env %}
        webhook_secret: Optional[str] = None,
{% endif %}
{% if c.servers %}
        environment: Optional[Environment] = None,
{% endif %}
        base_url: Optional[str] = None,
        timeout: Timeout = DEFAULT_TIMEOUT,
        max_retries: int = DEFAULT_MAX_RETRIES,
        http_client: Optional[httpx.Client] = None,
    ) -> None:
        super().__init__(
{% if c.auth %}
            auth=_resolve_auth({% for a in c.ctor_args %}{{ a.ident }}{% if not loop.last %}, {% endif %}{% endfor %}),
{% else %}
            auth=None,
{% endif %}
{% if c.servers %}
            base_url=_resolve_base_url(environment, base_url),
{% else %}
            base_url=_resolve_base_url(None, base_url),
{% endif %}
            timeout=timeout,
            max_retries=max_retries,
{% if c.webhook_secret_env %}
            webhook_secret=webhook_secret,
{% else %}
            webhook_secret=None,
{% endif %}
            http_client=http_client,
        )
{% for r in c.resources %}
        self.{{ r.module }} = {{ r.class }}(self)
{% endfor %}
        self.with_raw_response = {{ c.class }}WithRawResponse(self)

    def __enter__(self) -> {{ c.class }}:
        return self

    def __exit__(
        self,
        exc_type: Optional[Type[BaseException]],
        exc: Optional[BaseException],
        tb: Optional[TracebackType],
    ) -> None:
        self.close()


