"""Exceptions raised by the SDK.

Every message says what failed and what to try next, so a caller (or an agent) can recover
without reading the docs.
"""

from __future__ import annotations

import json
import time
from email.utils import parsedate_to_datetime
from typing import Any, Mapping, Optional

import httpx


class {{ c.error_base }}(Exception):
    """Base class for every error this SDK raises."""


class APIConnectionError({{ c.error_base }}):
    """The request never got a response (DNS, refused connection, dropped socket)."""


class APITimeoutError(APIConnectionError):
    """The server did not answer within the timeout."""


class WebhookVerificationError({{ c.error_base }}):
    """A webhook's signature, timestamp or headers didn't check out. Don't trust the payload."""


class APIError({{ c.error_base }}):
    """The API answered with an error status."""

    hint: Optional[str] = None

    def __init__(
        self,
        status_code: int,
        message: str,
        body: Any = None,
        request_id: Optional[str] = None,
        *,
        retry_after: Optional[float] = None,
    ) -> None:
        self.status_code = status_code
        self.message = message
        self.body = body
        self.request_id = request_id
        self.retry_after = retry_after
        text = message
        if request_id:
            text += f" (request_id={request_id})"
        hint = self.get_hint()
        if hint:
            text += f"\nHint: {hint}"
        super().__init__(text)

    def get_hint(self) -> Optional[str]:
        return self.hint


class BadRequestError(APIError):
    hint = (
        "Fix the parameter named in the message and call again. "
        "Repeating the same request will fail the same way."
    )


class AuthenticationError(APIError):
