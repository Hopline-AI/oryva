[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ c.dist }}"
version = "{{ c.version }}"
description = {{ c.summary | q }}
readme = "README.md"
requires-python = ">=3.9"
dependencies = [
    "httpx>=0.27,<1",
    "pydantic>=2.5,<3",
    "typing-extensions>=4.7",
]

[tool.hatch.build.targets.wheel]
packages = ["src/{{ c.pkg }}"]

[tool.ruff.lint]
select = ["E4", "E7", "E9", "F", "I"]
