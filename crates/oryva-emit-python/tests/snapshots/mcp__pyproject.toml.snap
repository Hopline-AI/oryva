---
source: crates/oryva-emit-python/tests/generate.rs
expression: content
---
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "sarvam-mcp"
version = "1.0"
description = "MCP server for the Sarvam API (lite fixture)"
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "sarvam>=1.0",
    "mcp>=2,<3",
]

[project.scripts]
sarvam-mcp = "sarvam_mcp.server:main"

[tool.hatch.build.targets.wheel]
packages = ["src/sarvam_mcp"]

[tool.ruff.lint]
select = ["E4", "E7", "E9", "F", "I"]
