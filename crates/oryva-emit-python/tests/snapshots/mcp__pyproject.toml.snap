---
source: crates/oryva-emit-python/tests/generate.rs
expression: content
---
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "ledger-mcp"
version = "2026.10.01"
description = "MCP server for the Ledger API"
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "ledger>=2026.10.01",
    "mcp>=2,<3",
]

[project.scripts]
ledger-mcp = "ledger_mcp.server:main"

[tool.hatch.build.targets.wheel]
packages = ["src/ledger_mcp"]

[tool.ruff.lint]
select = ["E4", "E7", "E9", "F", "I"]
