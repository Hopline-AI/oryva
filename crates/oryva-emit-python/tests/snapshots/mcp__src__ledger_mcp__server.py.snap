@server.tool(
    name="refunds_create",
    title="Refund all or part of a payment",
    annotations=ToolAnnotations(
        title="Refund all or part of a payment",
        read_only_hint=False,
        destructive_hint=True,
        idempotent_hint=False,
    ),
    structured_output=False,
)
def refunds_create(
    payment_id: str,
    amount: Annotated[
        Optional[int],
        Field(
            description="Smallest currency unit. Omit to refund the full remaining amount."
        ),
    ] = None,
    reason: Optional[
        Union[Literal["duplicate", "fraudulent", "requested_by_customer"], str]
    ] = None,
) -> str:
    """Refund all or part of a payment.

    Moves money back to the customer and can't be reversed. Check the payment's amount first; a refund can't exceed what's left to refund.
    """
    with _tool_errors():
        result = _sdk().refunds.create(
            payment_id=payment_id, **_given(amount=amount, reason=reason)
        )
    return _to_json(result)


