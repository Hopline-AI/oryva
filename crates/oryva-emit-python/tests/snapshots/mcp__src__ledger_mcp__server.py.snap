@server.tool(
    name="events_stream",
    title="Stream account events as they happen",
    annotations=ToolAnnotations(
        title="Stream account events as they happen",
        read_only_hint=True,
        destructive_hint=False,
        idempotent_hint=True,
    ),
    structured_output=False,
)
def events_stream(
    max_events: Annotated[
        int, Field(ge=1, description="Stop after this many events.")
    ] = 10,
) -> str:
    """Stream account events as they happen.

    Long-lived. Read a few events and stop; don't wait for the stream to end.

    Reads up to `max_events` events, then closes the stream and returns them.
    """
    with _tool_errors():
        events: List[Any] = []
        with _sdk().events.stream() as stream:
            for event in stream:
                events.append(event)
                if len(events) >= max_events:
                    break
    return _to_json({"events": events, "count": len(events)})


def main() -> None:
    """Run the server over stdio."""
    server.run()


if __name__ == "__main__":
    main()
