"""MCP server exposing the Ledger API as tools."""

from __future__ import annotations

import json
import mimetypes
import os
import tempfile
from contextlib import contextmanager
from datetime import date
from pathlib import Path
from typing import Annotated, Any, Dict, Iterator, List, Literal, Optional, Union

from ledger import Ledger, LedgerError
from ledger.types import Currency, LineItem
from mcp.server.mcpserver import MCPServer
from mcp.server.mcpserver.exceptions import ToolError
from mcp_types import ToolAnnotations
from pydantic import BaseModel, Field

server = MCPServer(
    "ledger",
    instructions="Customers, invoices, payments and refunds for small businesses.",
)

_client: Optional[Ledger] = None
_output_dir: Optional[Path] = None


def _sdk() -> Ledger:
    """Create the SDK client on first use so the server starts without credentials.

    The SDK reads its credentials, environment and base URL from environment variables.
    """
    global _client
    if _client is None:
        _client = Ledger()
    return _client


@contextmanager
def _tool_errors() -> Iterator[None]:
    """Report SDK errors as tool errors that carry the SDK's own message."""
    try:
        yield
    except LedgerError as exc:
        raise ToolError(str(exc)) from exc


def _given(**kwargs: Any) -> Dict[str, Any]:
    """The arguments the caller passed. A tool can't tell an omitted argument from null, and
    the SDK would send None as null, so None is left out."""
    return {k: v for k, v in kwargs.items() if v is not None}


def _jsonable(value: Any) -> Any:
    if isinstance(value, BaseModel):
        return value.model_dump(mode="json", exclude_none=True)
    if isinstance(value, list):
        return [_jsonable(v) for v in value]
    if isinstance(value, dict):
        return {k: _jsonable(v) for k, v in value.items()}
    return value


def _to_json(value: Any) -> str:
    return json.dumps(_jsonable(value), indent=2, ensure_ascii=False)


def _page_json(page: Any) -> str:
    """One page, plus the arguments that fetch the next one (null on the last page)."""
    return _to_json({**_jsonable(page.response), "next_page": page.next_page_info()})


def _save_binary(data: bytes, name: str, content_type: str) -> str:
    """Write a binary response to disk and return its path and size, never the bytes."""
    global _output_dir
    if _output_dir is None:
        configured = os.environ.get("LEDGER_MCP_OUTPUT_DIR")
        _output_dir = (
            Path(configured)
            if configured
            else Path(tempfile.mkdtemp(prefix="ledger_mcp-"))
        )
        _output_dir.mkdir(parents=True, exist_ok=True)
    extension = mimetypes.guess_extension(content_type.split(";")[0].strip()) or ".bin"
    handle, path = tempfile.mkstemp(
        prefix=f"{name}-", suffix=extension, dir=_output_dir
    )
    with os.fdopen(handle, "wb") as f:
        f.write(data)
    return _to_json(
        {"path": path, "size_bytes": len(data), "content_type": content_type}
    )


@server.tool(
    name="customers_list",
    title="List customers, newest first",
    annotations=ToolAnnotations(
        title="List customers, newest first",
        read_only_hint=True,
        destructive_hint=False,
        idempotent_hint=True,
    ),
    structured_output=False,
)
def customers_list(
    limit: Annotated[
        Optional[int], Field(description="Maximum items per page (at most 100).")
    ] = None,
    starting_after: Annotated[
        Optional[str],
        Field(description="Cursor from the previous page's `next_cursor`."),
    ] = None,
    email: Annotated[
        Optional[str], Field(description="Only customers with exactly this email.")
    ] = None,
) -> str:
    """List customers, newest first.

    Returns one page of results. When `next_page` in the result is not null, call this tool again with those arguments added to get the next page.
    """
    with _tool_errors():
        result = _sdk().customers.list(
            **_given(limit=limit, starting_after=starting_after, email=email)
        )
    return _page_json(result)


@server.tool(
    name="customers_create",
    title="Create a customer",
    annotations=ToolAnnotations(
        title="Create a customer",
        read_only_hint=False,
        destructive_hint=False,
        idempotent_hint=False,
    ),
    structured_output=False,
)
def customers_create(
    name: str,
    email: Optional[str] = None,
    metadata: Annotated[
        Optional[Dict[str, str]], Field(description="Your own key-value pairs.")
    ] = None,
) -> str:
    """Create a customer."""
    with _tool_errors():
        result = _sdk().customers.create(
            name=name, **_given(email=email, metadata=metadata)
        )
    return _to_json(result)


