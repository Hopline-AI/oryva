@server.tool(
    name="customers_delete",
    title="Delete a customer and all their unpaid invoices",
    annotations=ToolAnnotations(
        title="Delete a customer and all their unpaid invoices",
        read_only_hint=False,
        destructive_hint=True,
        idempotent_hint=True,
    ),
    structured_output=False,
)
def customers_delete(
    customer_id: str,
) -> str:
    """Delete a customer and all their unpaid invoices.

    Permanent, and also deletes the customer's draft and open invoices. Fetch the customer first and confirm with the user.
    """
    with _tool_errors():
        _sdk().customers.delete(customer_id=customer_id)
    return "Done. The API returned no content."


