@server.tool(
    name="invoices_finalize",
    title="Turn a draft invoice into an open one and email it to the customer",
    annotations=ToolAnnotations(
        title="Turn a draft invoice into an open one and email it to the customer",
        read_only_hint=False,
        destructive_hint=False,
        idempotent_hint=False,
    ),
    structured_output=False,
)
def invoices_finalize(
    invoice_id: str,
) -> str:
    """Turn a draft invoice into an open one and email it to the customer.

    Emails the customer immediately; this can't be undone.
    """
    with _tool_errors():
        result = _sdk().invoices.finalize(invoice_id=invoice_id)
    return _to_json(result)


@server.tool(
    name="invoices_void",
    title="Void an open invoice so it can no longer be paid",
    annotations=ToolAnnotations(
        title="Void an open invoice so it can no longer be paid",
        read_only_hint=False,
        destructive_hint=True,
        idempotent_hint=True,
    ),
    structured_output=False,
)
def invoices_void(
    invoice_id: str,
) -> str:
    """Void an open invoice so it can no longer be paid.

    Permanent. Only open invoices can be voided.
    """
    with _tool_errors():
        result = _sdk().invoices.void(invoice_id=invoice_id)
    return _to_json(result)


@server.tool(
    name="invoices_download_pdf",
    title="Download the invoice as a PDF",
    annotations=ToolAnnotations(
        title="Download the invoice as a PDF",
        read_only_hint=True,
        destructive_hint=False,
        idempotent_hint=True,
    ),
    structured_output=False,
)
def invoices_download_pdf(
    invoice_id: str,
) -> str:
    """Download the invoice as a PDF.

    The response is binary (application/pdf). It is saved to a file; the result gives its path and size.
    """
    with _tool_errors():
        result = _sdk().invoices.download_pdf(invoice_id=invoice_id)
    return _save_binary(result, "invoices_download_pdf", "application/pdf")


