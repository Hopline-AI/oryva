---
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "sarvam"
version = "1.0"
description = "Speech, text and translation models for Indian languages."
readme = "README.md"
requires-python = ">=3.9"
dependencies = [
    "httpx>=0.27,<1",
    "pydantic>=2,<3",
]

[tool.hatch.build.targets.wheel]
packages = ["src/sarvam"]

[tool.ruff.lint]
select = ["E4", "E7", "E9", "F", "I"]
