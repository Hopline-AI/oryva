from __future__ import annotations

from typing import TYPE_CHECKING, Optional

from ..types import FileInput, SpeechToTextTranscribeResponse

if TYPE_CHECKING:
    from .._client import Sarvam


class SpeechToText:
    """Speech to text endpoints."""

    def __init__(self, client: Sarvam) -> None:
        self._client = client

    def transcribe(
        self,
        *,
        file: FileInput,
        language_code: Optional[str] = None,
    ) -> SpeechToTextTranscribeResponse:
        """Transcribe an audio file.

        Args:
            file: WAV or MP3 audio, at most 30 seconds.
            language_code: Spoken language, or `unknown` to detect it.

        Raises:
            BadRequestError: The request was invalid. The message names the offending field.
        """
        files = {"file": file}
        data = {"language_code": language_code}
        response = self._client._request(
            "POST",
            "/speech-to-text",
            files=files,
            data=data,
        )
        return SpeechToTextTranscribeResponse.model_validate(response.json())
