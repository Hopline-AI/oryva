from __future__ import annotations

from typing import TYPE_CHECKING, Literal, Optional, Union

from ..types import (
    LanguageCode,
    TextIdentifyLanguageResponse,
    TextTransliterateResponse,
    TranslateResponse,
)

if TYPE_CHECKING:
    from .._client import Sarvam


class Text:
    """Text endpoints."""

    def __init__(self, client: Sarvam) -> None:
        self._client = client

    def translate(
        self,
        *,
        input: str,
        source_language_code: Union[LanguageCode, Literal["auto"]],
        target_language_code: LanguageCode,
        mode: Optional[
            Literal["formal", "modern-colloquial", "classic-colloquial", "code-mixed"]
        ] = None,
    ) -> TranslateResponse:
        """Translate text between Indian languages and English.

        Args:
            input: Text to translate. At most 2000 characters.
            source_language_code: Source language, or `auto` to detect it.

        Raises:
            BadRequestError: The request was invalid. The message names the offending field.
            RateLimitError: Too many requests. Retry after the number of seconds in Retry-After.
        """
        body = {
            "input": input,
            "source_language_code": source_language_code,
            "target_language_code": target_language_code,
            "mode": mode,
        }
        response = self._client._request("POST", "/translate", json=body)
        return TranslateResponse.model_validate(response.json())

    def transliterate(
        self,
        *,
        input: str,
        source_language_code: LanguageCode,
        target_language_code: LanguageCode,
    ) -> TextTransliterateResponse:
        """Convert text between scripts without translating it.

        Raises:
            BadRequestError: The request was invalid. The message names the offending field.
        """
        body = {
            "input": input,
            "source_language_code": source_language_code,
            "target_language_code": target_language_code,
        }
        response = self._client._request("POST", "/transliterate", json=body)
        return TextTransliterateResponse.model_validate(response.json())

    def identify_language(
        self,
        *,
        input: str,
    ) -> TextIdentifyLanguageResponse:
        """Identify the language and script of a piece of text.

        Call this before translate only when you need the language code itself; translate already accepts `auto`.
        """
        body = {"input": input}
        response = self._client._request("POST", "/text-lid", json=body)
        return TextIdentifyLanguageResponse.model_validate(response.json())
