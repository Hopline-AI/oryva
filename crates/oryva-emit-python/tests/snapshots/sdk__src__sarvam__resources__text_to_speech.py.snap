from __future__ import annotations

from typing import TYPE_CHECKING, Literal, Optional

from ..types import LanguageCode, TextToSpeechConvertResponse

if TYPE_CHECKING:
    from .._client import Sarvam


class TextToSpeech:
    """Text to speech endpoints."""

    def __init__(self, client: Sarvam) -> None:
        self._client = client

    def convert(
        self,
        *,
        text: str,
        target_language_code: LanguageCode,
        speaker: Optional[
            Literal[
                "anushka", "abhilash", "manisha", "vidya", "arya", "karun", "hitesh"
            ]
        ] = None,
        pace: Optional[float] = None,
    ) -> TextToSpeechConvertResponse:
        """Synthesize speech from text.

        Returns base64-encoded WAV audio in `audios`. Save it to a file rather than reading it back. At most 1500 characters of text per call.

        Args:
            pace: Speaking rate from 0.5 to 2.0.

        Raises:
            BadRequestError: The request was invalid. The message names the offending field.
        """
        body = {
            "text": text,
            "target_language_code": target_language_code,
            "speaker": speaker,
            "pace": pace,
        }
        response = self._client._request("POST", "/text-to-speech", json=body)
        return TextToSpeechConvertResponse.model_validate(response.json())
