from __future__ import annotations

import os
from datetime import datetime
from typing import BinaryIO, List, Literal, Optional, Union

from pydantic import BaseModel, ConfigDict

FileInput = Union[bytes, str, "os.PathLike[str]", BinaryIO]
"""A file to upload: raw bytes, a path, or a file object opened in binary mode."""

LanguageCode = Literal[
    "en-IN",
    "hi-IN",
    "bn-IN",
    "ta-IN",
    "te-IN",
    "kn-IN",
    "ml-IN",
    "mr-IN",
    "gu-IN",
    "pa-IN",
    "od-IN",
]
"""BCP-47 code of an Indian language or English."""


class TranslateRequest(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)

    input: str
    """Text to translate. At most 2000 characters."""
    source_language_code: Union[LanguageCode, Literal["auto"]]
    """Source language, or `auto` to detect it."""
    target_language_code: LanguageCode
    mode: Optional[
        Literal["formal", "modern-colloquial", "classic-colloquial", "code-mixed"]
    ] = None


class TranslateResponse(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)

    request_id: Optional[str] = None
    translated_text: str
    source_language_code: str
    """The detected language when the request used `auto`."""


class Pronunciation(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)

    id: str
    word: str
    pronunciation: str
    """Phonetic spelling the speech models should use."""
    created_at: Optional[datetime] = None


class ErrorResponseError(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)

    message: str
    code: str
    request_id: Optional[str] = None


class ErrorResponse(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)

    error: ErrorResponseError


class TextTransliterateRequest(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)

    input: str
    source_language_code: LanguageCode
    target_language_code: LanguageCode


class TextTransliterateResponse(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)

    transliterated_text: str


class TextIdentifyLanguageRequest(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)

    input: str


class TextIdentifyLanguageResponse(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)

    language_code: Optional[str] = None
    script_code: Optional[str] = None


class TextToSpeechConvertRequest(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)

    text: str
    target_language_code: LanguageCode
    speaker: Optional[
        Literal["anushka", "abhilash", "manisha", "vidya", "arya", "karun", "hitesh"]
    ] = None
    pace: Optional[float] = None
    """Speaking rate from 0.5 to 2.0."""


class TextToSpeechConvertResponse(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)

    request_id: Optional[str] = None
    audios: List[str]


class SpeechToTextTranscribeRequest(BaseModel):
    model_config = ConfigDict(
        extra="allow", populate_by_name=True, arbitrary_types_allowed=True
    )

    file: FileInput
    """WAV or MP3 audio, at most 30 seconds."""
    language_code: Optional[str] = None
    """Spoken language, or `unknown` to detect it."""


class SpeechToTextTranscribeResponse(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)

    transcript: str
    language_code: Optional[str] = None


class PronunciationsCreateRequest(BaseModel):
    model_config = ConfigDict(extra="allow", populate_by_name=True)

    word: str
    pronunciation: str
